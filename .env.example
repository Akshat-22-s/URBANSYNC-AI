# Google Maps (optional)
GOOGLE_MAPS_API_KEY=your_key_here

# Safety
UP112_DISPATCH_ENDPOINT=https://up112-cad.example.gov.in/api/dispatch
DURESS_SAFE_PIN=1234
DURESS_TRIGGER_PIN=9999

# Simulator
SIMULATOR_TICK_MS=2000
